---
import Layout from '../layouts/MainLayout.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  pageTitle="Privacy Policy — Tooliva"
  pageDescription="Tooliva privacy policy — how we handle your data. We do not collect, store, or share any personal information."
>
  <section class="page-band">
    <div class="page-container">
      <h1 class="page-title">Privacy Policy.</h1>
      <p class="page-subtitle">
        We believe privacy is a fundamental right. Here&rsquo;s how we handle your data.
      </p>
    </div>
  </section>

  <section class="content-band">
    <div class="page-container content">
      <h2 class="content-heading">Information We Collect</h2>
      <p>
        Tooliva does <strong>not</strong> collect, store, or transmit any personal data. All tools run
        entirely client-side in your browser. Your inputs never leave your device.
      </p>
      <p>
        We do not use cookies, tracking scripts, analytics services, or third-party data processors.
        There are no log-in requirements, account registrations, or user profiles.
      </p>

      <h2 class="content-heading">Data Processing</h2>
      <p>
        Any text, JSON, JWT tokens, or other data you enter into our tools is processed exclusively
        within your browser using JavaScript. No server-side processing occurs. Once you close the
        page, all data is gone.
      </p>

      <h2 class="content-heading">Third-Party Services</h2>
      <p>
        This website is hosted on Vercel. Vercel may process standard request metadata
        (IP address, browser user-agent, requested URL) for the sole purpose of delivering the page. We
        do not have access to this information and do not use it for any analytical or tracking purpose.
      </p>

      <h2 class="content-heading">Changes to This Policy</h2>
      <p>
        If this policy changes, we will update this page. You can review the history of changes in
        our public repository.
      </p>

      <h2 class="content-heading">Contact</h2>
      <p>
        If you have questions about this policy, email us at <a
          href="mailto:hello@tooliva.com"
          class="page-link">hello@tooliva.com</a
        >.
      </p>

      <p class="content-meta">Last updated: June 2026</p>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  .page-band {
    padding: var(--spacing-5xl) var(--spacing-lg) 0;
  }
  .page-container {
    max-width: 1400px;
    margin: 0 auto;
  }
  .page-title {
    font-size: var(--font-size-display-lg);
    font-weight: var(--font-weight-display-lg);
    letter-spacing: -1.28px;
    color: var(--color-ink);
    margin: 0;
    line-height: 1.25;
  }
  .page-subtitle {
    font-size: var(--font-size-body-md);
    font-weight: var(--font-weight-body-md);
    color: var(--color-body);
    margin: var(--spacing-sm) 0 0;
    line-height: 1.5;
  }
  .content-band {
    padding: var(--spacing-xl) var(--spacing-lg) var(--spacing-5xl);
  }
  .content {
    max-width: 720px;
  }
  .content-heading {
    font-size: var(--font-size-display-sm);
    font-weight: var(--font-weight-display-md);
    color: var(--color-ink);
    margin: var(--spacing-2xl) 0 var(--spacing-sm);
    line-height: 1.3;
    letter-spacing: -0.5px;
  }
  .content-heading:first-of-type {
    margin-top: 0;
  }
  .content p {
    font-size: var(--font-size-body-md);
    font-weight: var(--font-weight-body-md);
    color: var(--color-body);
    line-height: 1.7;
    margin: 0 0 var(--spacing-md);
  }
  .content p:last-of-type {
    margin-bottom: 0;
  }
  .content strong {
    color: var(--color-ink);
    font-weight: 500;
  }
  .page-link {
    color: var(--color-link);
    text-decoration: underline;
    font-weight: 500;
  }
  .page-link:hover {
    color: var(--color-link-deep);
  }
  .content-meta {
    font-size: var(--font-size-body-sm) !important;
    color: var(--color-mute) !important;
    margin-top: var(--spacing-3xl) !important;
  }
</style>
