---
import ToolLayout from '../../layouts/ToolLayout.astro';
---

<ToolLayout
  title="Password Generator"
  description="Free online password generator — generate strong, secure random passwords. Fast, client-side password creation tool."
  keywords="password generator, random password, strong password generator, secure password, password creator, free password generator, online password tool"
>
  <div class="controls-row">
    <div class="control-group">
      <label class="control-label" for="length">Length: <span id="length-label">16</span></label>
      <input id="length" class="length-slider" type="range" min="4" max="64" value="16" />
    </div>
  </div>

  <div class="options-row">
    <label class="option-label"><input type="checkbox" id="opt-upper" class="option-checkbox" checked /> Uppercase (A-Z)</label>
    <label class="option-label"><input type="checkbox" id="opt-lower" class="option-checkbox" checked /> Lowercase (a-z)</label>
    <label class="option-label"><input type="checkbox" id="opt-digits" class="option-checkbox" checked /> Digits (0-9)</label>
    <label class="option-label"><input type="checkbox" id="opt-symbols" class="option-checkbox" /> Symbols (!@#$%^&*)</label>
    <label class="option-label"><input type="checkbox" id="opt-ambiguous" class="option-checkbox" /> Exclude ambiguous (Il1O0)</label>
  </div>

  <div class="count-row">
    <label class="control-label" for="count">Count</label>
    <input id="count" class="count-input" type="number" value="5" min="1" max="50" />
  </div>

  <div class="button-row">
    <button class="btn-primary" id="btn-generate">Generate</button>
    <button class="btn-secondary" id="btn-copy">Copy All</button>
    <button class="btn-secondary" id="btn-clear">Clear</button>
    <span class="shortcut-hint" aria-live="polite">Ctrl+Enter to generate</span>
  </div>

  <div id="error" class="error-msg" role="alert" hidden></div>

  <div id="strength" class="strength-bar" hidden>
    <div class="strength-fill" id="strength-fill"></div>
    <span class="strength-label" id="strength-label"></span>
  </div>

  <div class="output-area">
    <pre id="output" class="output-content" aria-label="Generated passwords" data-placeholder="Generated passwords will appear here..."></pre>
  </div>
</ToolLayout>

<script>
  const lengthSlider = document.getElementById('length') as HTMLInputElement;
  const lengthLabel = document.getElementById('length-label') as HTMLSpanElement;
  const countInput = document.getElementById('count') as HTMLInputElement;
  const output = document.getElementById('output') as HTMLPreElement;
  const errorEl = document.getElementById('error') as HTMLDivElement;
  const copyBtn = document.getElementById('btn-copy') as HTMLButtonElement;
  const strength = document.getElementById('strength') as HTMLDivElement;
  const strengthFill = document.getElementById('strength-fill') as HTMLDivElement;
  const strengthLabel = document.getElementById('strength-label') as HTMLSpanElement;

  lengthSlider.addEventListener('input', () => { lengthLabel.textContent = lengthSlider.value; });

  function getChars(): string {
    let chars = '';
    if ((document.getElementById('opt-upper') as HTMLInputElement).checked) chars += 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';
    if ((document.getElementById('opt-lower') as HTMLInputElement).checked) chars += 'abcdefghijklmnopqrstuvwxyz';
    if ((document.getElementById('opt-digits') as HTMLInputElement).checked) chars += '0123456789';
    if ((document.getElementById('opt-symbols') as HTMLInputElement).checked) chars += '!@#$%^&*()_+-=[]{}|;:,.<>?';
    if ((document.getElementById('opt-ambiguous') as HTMLInputElement).checked) chars = chars.replace(/[Il1O0]/g, '');
    return chars;
  }

  function getStrength(length: number, charset: string): { label: string; pct: number; color: string } {
    const pool = charset.length;
    if (pool === 0) return { label: 'None', pct: 0, color: '#888' };
    const entropy = Math.log2(pool) * length;
    if (entropy < 40) return { label: 'Weak', pct: 25, color: '#ee0000' };
    if (entropy < 60) return { label: 'Fair', pct: 50, color: '#f5a623' };
    if (entropy < 80) return { label: 'Strong', pct: 75, color: '#0070f3' };
    return { label: 'Very strong', pct: 100, color: '#00b359' };
  }

  function generatePassword(length: number, chars: string): string {
    const array = new Uint32Array(length);
    crypto.getRandomValues(array);
    return Array.from(array, x => chars[x % chars.length]).join('');
  }

  function generate() {
    const len = parseInt(lengthSlider.value, 10);
    let n = parseInt(countInput.value, 10);
    if (isNaN(n) || n < 1) n = 1;
    if (n > 50) n = 50;
    countInput.value = String(n);
    const chars = getChars();
    if (!chars) { errorEl.textContent = 'Select at least one character type.'; errorEl.hidden = false; output.textContent = ''; strength.hidden = true; return; }
    errorEl.hidden = true;
    const passwords: string[] = [];
    for (let i = 0; i < n; i++) passwords.push(generatePassword(len, chars));
    output.textContent = passwords.join('\n');
    const s = getStrength(len, chars);
    strengthFill.style.width = s.pct + '%';
    strengthFill.style.backgroundColor = s.color;
    strengthLabel.textContent = s.label;
    strength.hidden = false;
  }

  function copyOutput() {
    const text = output.textContent;
    if (!text) return;
    navigator.clipboard.writeText(text).then(() => {
      const orig = copyBtn.textContent || '';
      copyBtn.textContent = 'Copied \u2713';
      copyBtn.classList.add('btn-copied');
      setTimeout(() => { copyBtn.textContent = orig; copyBtn.classList.remove('btn-copied'); }, 1500);
    }).catch(() => {});
  }

  function clearAll() {
    output.textContent = '';
    errorEl.hidden = true;
    strength.hidden = true;
  }

  function handleKeydown(e: KeyboardEvent) {
    if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') { e.preventDefault(); generate(); }
    if (e.key === 'Escape') { clearAll(); }
  }

  function mount() {
    document.addEventListener('keydown', handleKeydown);
    document.getElementById('btn-generate')!.addEventListener('click', generate);
    document.getElementById('btn-copy')!.addEventListener('click', copyOutput);
    document.getElementById('btn-clear')!.addEventListener('click', clearAll);
  }
  mount();
  document.addEventListener('astro:before-swap', () => document.removeEventListener('keydown', handleKeydown));
</script>

<style>
  .controls-row { margin-bottom: var(--spacing-md); }
  .control-group { display: flex; flex-direction: column; gap: var(--spacing-xs); }
  .control-label { font-size: var(--font-size-body-sm); font-weight: 500; color: var(--color-ink); }
  .length-slider { width: 100%; max-width: 400px; accent-color: var(--color-primary); cursor: pointer; }
  .options-row { display: flex; flex-wrap: wrap; gap: var(--spacing-md); margin-bottom: var(--spacing-md); }
  .option-label { display: flex; align-items: center; gap: var(--spacing-xs); font-size: var(--font-size-body-sm); color: var(--color-body); cursor: pointer; }
  .option-checkbox { width: 16px; height: 16px; accent-color: var(--color-primary); cursor: pointer; }
  .count-row { display: flex; align-items: center; gap: var(--spacing-sm); margin-bottom: var(--spacing-md); }
  .count-input { width: 80px; padding: 6px 12px; font-size: var(--font-size-body-md); background-color: var(--color-canvas); color: var(--color-ink); border: 1px solid var(--color-hairline); border-radius: var(--border-radius-sm); text-align: center; box-sizing: border-box; }
  .count-input:focus { outline: 2px solid var(--color-ink); outline-offset: 2px; }
  .button-row { display: flex; gap: var(--spacing-sm); margin: var(--spacing-md) 0; align-items: center; flex-wrap: wrap; }
  .shortcut-hint { font-family: var(--font-geist-mono); font-size: var(--font-size-caption-mono); color: var(--color-mute); }
  @media (min-width: 640px) { .shortcut-hint { margin-left: auto; } }
  .error-msg { font-family: var(--font-geist-mono); font-size: var(--font-size-body-sm); color: var(--color-error); background-color: var(--color-error-soft); padding: var(--spacing-sm) var(--spacing-md); border-radius: var(--border-radius-sm); margin-bottom: var(--spacing-md); }
  .strength-bar { height: 8px; background-color: var(--color-hairline); border-radius: var(--border-radius-full); margin-bottom: var(--spacing-md); position: relative; }
  .strength-fill { height: 100%; border-radius: var(--border-radius-full); transition: width 0.3s ease, background-color 0.3s ease; }
  .strength-label { font-family: var(--font-geist-mono); font-size: var(--font-size-caption-mono); color: var(--color-mute); position: absolute; right: 0; top: -18px; }
  .output-area { background-color: var(--color-canvas-soft-2); border-radius: var(--border-radius-md); border: 1px solid #00000014; padding: 1rem; min-height: 200px; max-height: 600px; overflow-y: auto; }
  .output-content { font-family: var(--font-geist-mono); font-size: var(--font-size-code); line-height: 1.6; color: var(--color-ink); margin: 0; white-space: pre-wrap; word-break: break-all; }
</style>
