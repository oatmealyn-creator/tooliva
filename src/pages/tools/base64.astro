---
import ToolLayout from '../../layouts/ToolLayout.astro';
---

<ToolLayout title="Base64 Encoder &amp; Decoder" description="Encode and decode Base64 strings.">
  <textarea id="input" class="input-area" placeholder="Enter text to encode or decode..." spellcheck="false"></textarea>

  <div class="button-row">
    <button class="btn-primary" id="btn-encode">Encode</button>
    <button class="btn-secondary" id="btn-decode">Decode</button>
    <button class="btn-secondary" id="btn-copy">Copy</button>
    <button class="btn-secondary" id="btn-clear">Clear</button>
  </div>

  <div id="error" class="error-msg" hidden></div>

  <div class="output-area">
    <pre id="output" class="output-content" aria-label="Base64 result"></pre>
  </div>
</ToolLayout>

<script>
  const input = document.getElementById('input') as HTMLTextAreaElement;
  const output = document.getElementById('output') as HTMLPreElement;
  const errorEl = document.getElementById('error') as HTMLDivElement;

  function encode(str: string): string {
    return btoa(unescape(encodeURIComponent(str)));
  }

  function decode(str: string): string | null {
    try {
      return decodeURIComponent(escape(atob(str.trim())));
    } catch (e) {
      return null;
    }
  }

  function doEncode() {
    const raw = input.value;
    if (!raw) return;
    errorEl.hidden = true;
    output.textContent = encode(raw);
  }

  function doDecode() {
    const raw = input.value;
    if (!raw) return;
    errorEl.hidden = true;
    const result = decode(raw);
    if (result === null) {
      errorEl.textContent = 'Invalid Base64';
      errorEl.hidden = false;
      output.textContent = '';
    } else {
      output.textContent = result;
    }
  }

  function copyOutput() {
    const text = output.textContent;
    if (!text) return;
    navigator.clipboard.writeText(text).catch(() => {});
  }

  function clearAll() {
    input.value = '';
    output.textContent = '';
    errorEl.hidden = true;
  }

  document.getElementById('btn-encode')!.addEventListener('click', doEncode);
  document.getElementById('btn-decode')!.addEventListener('click', doDecode);
  document.getElementById('btn-copy')!.addEventListener('click', copyOutput);
  document.getElementById('btn-clear')!.addEventListener('click', clearAll);
</script>

<style>
  .input-area {
    width: 100%;
    min-height: 200px;
    padding: var(--spacing-md);
    font-family: var(--font-geist-mono);
    font-size: var(--font-size-code);
    line-height: 1.5;
    background-color: var(--color-canvas);
    color: var(--color-ink);
    border: 1px solid var(--color-hairline);
    border-radius: var(--border-radius-sm);
    resize: vertical;
    box-sizing: border-box;
  }
  .input-area:focus {
    outline: 2px solid var(--color-ink);
    outline-offset: 2px;
  }
  .input-area::placeholder {
    color: var(--color-mute);
  }
  .button-row {
    display: flex;
    gap: var(--spacing-sm);
    margin: var(--spacing-md) 0;
    flex-wrap: wrap;
  }
  .error-msg {
    font-family: var(--font-geist-mono);
    font-size: var(--font-size-body-sm);
    color: var(--color-error);
    background-color: var(--color-error-soft);
    padding: var(--spacing-sm) var(--spacing-md);
    border-radius: var(--border-radius-sm);
    margin-bottom: var(--spacing-md);
  }
  .output-area {
    background-color: var(--color-canvas-soft-2);
    border-radius: var(--border-radius-md);
    border: 1px solid #00000014;
    padding: var(--spacing-md);
    min-height: 80px;
  }
  .output-content {
    font-family: var(--font-geist-mono);
    font-size: var(--font-size-code);
    line-height: 1.5;
    color: var(--color-ink);
    margin: 0;
    white-space: pre-wrap;
    word-break: break-all;
    overflow-x: auto;
  }
</style>
