---
import ToolLayout from '../../layouts/ToolLayout.astro';
---

<ToolLayout
  title="Hash Generator"
  description="Free online hash generator — generate MD5, SHA1, SHA256 and SHA512 hashes instantly. Fast, client-side hashing tool."
  keywords="hash generator, md5 generator, sha256 generator, sha1 generator, sha512 generator, hash online, free hash tool, message digest"
>
  <div class="tool-header-row">
    <label for="input" class="sr-only">Text input</label>
    <textarea id="input" class="input-area monospace" placeholder="Enter text to hash..." spellcheck="false" autofocus></textarea>
    <button class="btn-secondary-sm try-sample" id="btn-sample">Try sample</button>
  </div>

  <div class="button-row">
    <button class="btn-primary" id="btn-hash">Generate</button>
    <button class="btn-secondary" id="btn-clear">Clear</button>
    <span class="shortcut-hint" aria-live="polite">Ctrl+Enter to hash</span>
  </div>

  <div id="error" class="error-msg" role="alert" hidden></div>

  <div id="results" class="hash-grid" hidden>
    <div class="hash-card"><span class="hash-label">MD5</span><code class="hash-value" id="md5-value"></code></div>
    <div class="hash-card"><span class="hash-label">SHA-1</span><code class="hash-value" id="sha1-value"></code></div>
    <div class="hash-card"><span class="hash-label">SHA-256</span><code class="hash-value" id="sha256-value"></code></div>
    <div class="hash-card"><span class="hash-label">SHA-512</span><code class="hash-value" id="sha512-value"></code></div>
  </div>
</ToolLayout>

<script>
  const input = document.getElementById('input') as HTMLTextAreaElement;
  const errorEl = document.getElementById('error') as HTMLDivElement;
  const results = document.getElementById('results') as HTMLDivElement;

  function md5(text: string): string {
    function rotateLeft(x: number, n: number): number { return (x << n) | (x >>> (32 - n)); }
    function toHex(i: number): string { return ('00000000' + i.toString(16)).slice(-8); }
    function strToBytes(s: string): number[] {
      const bytes: number[] = [];
      for (let i = 0; i < s.length; i++) {
        let c = s.charCodeAt(i);
        if (c < 128) bytes.push(c);
        else if (c < 2048) { bytes.push(192 | (c >> 6)); bytes.push(128 | (c & 63)); }
        else if (c < 65536) { bytes.push(224 | (c >> 12)); bytes.push(128 | ((c >> 6) & 63)); bytes.push(128 | (c & 63)); }
        else { bytes.push(240 | (c >> 18)); bytes.push(128 | ((c >> 12) & 63)); bytes.push(128 | ((c >> 6) & 63)); bytes.push(128 | (c & 63)); }
      }
      return bytes;
    }
    const K = [0xd76aa478, 0xe8c7b756, 0x242070db, 0xc1bdceee, 0xf57c0faf, 0x4787c62a, 0xa8304613, 0xfd469501,
               0x698098d8, 0x8b44f7af, 0xffff5bb1, 0x895cd7be, 0x6b901122, 0xfd987193, 0xa679438e, 0x49b40821,
               0xf61e2562, 0xc040b340, 0x265e5a51, 0xe9b6c7aa, 0xd62f105d, 0x02441453, 0xd8a1e681, 0xe7d3fbc8,
               0x21e1cde6, 0xc33707d6, 0xf4d50d87, 0x455a14ed, 0xa9e3e905, 0xfcefa3f8, 0x676f02d9, 0x8d2a4c8a,
               0xfffa3942, 0x8771f681, 0x6d9d6122, 0xfde5380c, 0xa4beea44, 0x4bdecfa9, 0xf6bb4b60, 0xbebfbc70,
               0x289b7ec6, 0xeaa127fa, 0xd4ef3085, 0x04881d05, 0xd9d4d039, 0xe6db99e5, 0x1fa27cf8, 0xc4ac5665,
               0xf4292244, 0x432aff97, 0xab9423a7, 0xfc93a039, 0x655b59c3, 0x8f0ccc92, 0xffeff47d, 0x85845dd1,
               0x6fa87e4f, 0xfe2ce6e0, 0xa3014314, 0x4e0811a1, 0xf7537e82, 0xbd3af235, 0x2ad7d2bb, 0xeb86d391];
    const s = [7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22,
               5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20,
               4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23,
               6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21];
    let bytes = strToBytes(text);
    const origLen = bytes.length * 8;
    bytes.push(0x80);
    while (bytes.length % 64 !== 56) bytes.push(0);
    for (let i = 0; i < 8; i++) bytes.push((origLen >>> (i * 8)) & 0xff);
    let a = 0x67452301, b = 0xefcdab89, c = 0x98badcfe, d_val = 0x10325476;
    for (let i = 0; i < bytes.length; i += 64) {
      const M: number[] = [];
      for (let j = 0; j < 64; j++) M.push(bytes[i + j]);
      const X: number[] = [];
      for (let j = 0; j < 16; j++) X[j] = M[j * 4] | (M[j * 4 + 1] << 8) | (M[j * 4 + 2] << 16) | (M[j * 4 + 3] << 24);
      let A = a, B = b, C = c, D = d_val;
      for (let j = 0; j < 64; j++) {
        let F: number, g: number;
        if (j < 16) { F = (B & C) | (~B & D); g = j; }
        else if (j < 32) { F = (D & B) | (~D & C); g = (5 * j + 1) % 16; }
        else if (j < 48) { F = B ^ C ^ D; g = (3 * j + 5) % 16; }
        else { F = C ^ (B | ~D); g = (7 * j) % 16; }
        F = (F + A + K[j] + X[g]) | 0;
        A = D; D = C; C = B; B = (B + rotateLeft(F, s[j])) | 0;
      }
      a = (a + A) | 0; b = (b + B) | 0; c = (c + C) | 0; d_val = (d_val + D) | 0;
    }
    return toHex(a) + toHex(b) + toHex(c) + toHex(d_val);
  }

  async function sha1(text: string): Promise<string> {
    const data = new TextEncoder().encode(text);
    const hash = await crypto.subtle.digest('SHA-1', data);
    return Array.from(new Uint8Array(hash)).map(b => b.toString(16).padStart(2, '0')).join('');
  }

  async function sha256(text: string): Promise<string> {
    const data = new TextEncoder().encode(text);
    const hash = await crypto.subtle.digest('SHA-256', data);
    return Array.from(new Uint8Array(hash)).map(b => b.toString(16).padStart(2, '0')).join('');
  }

  async function sha512(text: string): Promise<string> {
    const data = new TextEncoder().encode(text);
    const hash = await crypto.subtle.digest('SHA-512', data);
    return Array.from(new Uint8Array(hash)).map(b => b.toString(16).padStart(2, '0')).join('');
  }

  async function doHash() {
    const raw = input.value;
    if (!raw) { errorEl.textContent = 'Please enter text to hash.'; errorEl.hidden = false; results.hidden = true; return; }
    errorEl.hidden = true;
    results.hidden = true;
    try {
      document.getElementById('md5-value')!.textContent = md5(raw);
      const [s1, s256, s512] = await Promise.all([sha1(raw), sha256(raw), sha512(raw)]);
      document.getElementById('sha1-value')!.textContent = s1;
      document.getElementById('sha256-value')!.textContent = s256;
      document.getElementById('sha512-value')!.textContent = s512;
      results.hidden = false;
    } catch { errorEl.textContent = 'Hashing failed.'; errorEl.hidden = false; }
  }

  function clearAll() {
    input.value = '';
    errorEl.hidden = true;
    results.hidden = true;
  }

  function loadSample() {
    input.value = 'Hello, Tooliva!';
    errorEl.hidden = true;
    results.hidden = true;
  }

  function handleKeydown(e: KeyboardEvent) {
    if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') { e.preventDefault(); doHash(); }
    if (e.key === 'Escape') { clearAll(); }
  }

  function mount() {
    input.addEventListener('keydown', handleKeydown);
    document.getElementById('btn-hash')!.addEventListener('click', doHash);
    document.getElementById('btn-clear')!.addEventListener('click', clearAll);
    document.getElementById('btn-sample')!.addEventListener('click', loadSample);
  }
  mount();
  document.addEventListener('astro:before-swap', () => input.removeEventListener('keydown', handleKeydown));
</script>

<style>
  .tool-header-row { position: relative; }
  .try-sample { position: absolute; top: var(--spacing-sm); right: var(--spacing-sm); z-index: 1; }
  .input-area { width: 100%; min-height: 120px; padding: var(--spacing-md); font-size: var(--font-size-code); line-height: 1.5; background-color: var(--color-canvas); color: var(--color-ink); border: 1px solid var(--color-hairline); border-radius: var(--border-radius-sm); resize: vertical; box-sizing: border-box; }
  .input-area.monospace { font-family: var(--font-geist-mono); }
  .input-area:focus { outline: 2px solid var(--color-ink); outline-offset: 2px; }
  .input-area::placeholder { color: var(--color-mute); }
  .button-row { display: flex; gap: var(--spacing-sm); margin: var(--spacing-md) 0; align-items: center; flex-wrap: wrap; }
  .shortcut-hint { font-family: var(--font-geist-mono); font-size: var(--font-size-caption-mono); color: var(--color-mute); }
  @media (min-width: 640px) { .shortcut-hint { margin-left: auto; } }
  .error-msg { font-family: var(--font-geist-mono); font-size: var(--font-size-body-sm); color: var(--color-error); background-color: var(--color-error-soft); padding: var(--spacing-sm) var(--spacing-md); border-radius: var(--border-radius-sm); margin-bottom: var(--spacing-md); }
  .hash-grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--spacing-md); }
  @media (max-width: 640px) { .hash-grid { grid-template-columns: 1fr; } }
  .hash-card { background-color: var(--color-canvas-soft-2); border-radius: var(--border-radius-md); border: 1px solid #00000014; padding: var(--spacing-md); }
  .hash-label { font-family: var(--font-geist-mono); font-size: var(--font-size-caption-mono); color: var(--color-mute); text-transform: uppercase; letter-spacing: 0.05em; display: block; margin-bottom: var(--spacing-xs); }
  .hash-value { font-family: var(--font-geist-mono); font-size: var(--font-size-code); color: var(--color-ink); word-break: break-all; }
</style>
