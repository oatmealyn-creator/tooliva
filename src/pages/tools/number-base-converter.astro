---
import ToolLayout from '../../layouts/ToolLayout.astro';
---

<ToolLayout
  title="Number Base Converter"
  description="Free online number base converter — convert numbers between binary, octal, decimal and hexadecimal. Fast, client-side base conversion tool."
  keywords="number base converter, binary converter, hex converter, octal converter, decimal converter, base converter online, number system converter"
>
  <div class="field-row">
    <label for="input-value" class="field-label">Number</label>
    <input id="input-value" class="field-input monospace" placeholder="Enter a number" value="255" />
  </div>

  <div class="field-row">
    <label for="input-base" class="field-label">From base</label>
    <select id="input-base" class="base-select">
      <option value="2">Binary (2)</option>
      <option value="8">Octal (8)</option>
      <option value="10" selected>Decimal (10)</option>
      <option value="16">Hexadecimal (16)</option>
    </select>
  </div>

  <div class="button-row">
    <button class="btn-primary" id="btn-convert">Convert</button>
    <button class="btn-secondary" id="btn-clear">Clear</button>
    <span class="shortcut-hint" aria-live="polite">Ctrl+Enter to convert</span>
  </div>

  <div id="error" class="error-msg" role="alert" hidden></div>

  <div id="results" class="base-results" hidden>
    <div class="base-card">
      <span class="base-label">Binary (base 2)</span>
      <code class="base-value" id="bin-value"></code>
      <button class="base-copy btn-secondary-sm" data-copy="bin-value">Copy</button>
    </div>
    <div class="base-card">
      <span class="base-label">Octal (base 8)</span>
      <code class="base-value" id="oct-value"></code>
      <button class="base-copy btn-secondary-sm" data-copy="oct-value">Copy</button>
    </div>
    <div class="base-card">
      <span class="base-label">Decimal (base 10)</span>
      <code class="base-value" id="dec-value"></code>
      <button class="base-copy btn-secondary-sm" data-copy="dec-value">Copy</button>
    </div>
    <div class="base-card">
      <span class="base-label">Hexadecimal (base 16)</span>
      <code class="base-value" id="hex-value"></code>
      <button class="base-copy btn-secondary-sm" data-copy="hex-value">Copy</button>
    </div>
  </div>
</ToolLayout>

<script>
  const inputVal = document.getElementById('input-value') as HTMLInputElement;
  const inputBase = document.getElementById('input-base') as HTMLSelectElement;
  const errorEl = document.getElementById('error') as HTMLDivElement;
  const results = document.getElementById('results') as HTMLDivElement;

  function doConvert() {
    const raw = inputVal.value.trim();
    if (!raw) { errorEl.textContent = 'Please enter a number.'; errorEl.hidden = false; results.hidden = true; return; }
    errorEl.hidden = true;
    const fromBase = parseInt(inputBase.value, 10);
    const dec = parseInt(raw, fromBase);
    if (isNaN(dec)) { errorEl.textContent = 'Invalid number for the selected base.'; errorEl.hidden = false; results.hidden = true; return; }
    document.getElementById('bin-value')!.textContent = dec.toString(2);
    document.getElementById('oct-value')!.textContent = dec.toString(8);
    document.getElementById('dec-value')!.textContent = dec.toString(10);
    document.getElementById('hex-value')!.textContent = dec.toString(16).toUpperCase();
    results.hidden = false;
  }

  function clearAll() {
    inputVal.value = '';
    errorEl.hidden = true;
    results.hidden = true;
  }

  function handleKeydown(e: KeyboardEvent) {
    if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') { e.preventDefault(); doConvert(); }
    if (e.key === 'Escape') { clearAll(); }
  }

  function mount() {
    inputVal.addEventListener('keydown', handleKeydown);
    document.getElementById('btn-convert')!.addEventListener('click', doConvert);
    document.getElementById('btn-clear')!.addEventListener('click', clearAll);
    document.querySelectorAll('.base-copy').forEach(btn => {
      btn.addEventListener('click', () => {
        const id = (btn as HTMLElement).dataset.copy!;
        const text = document.getElementById(id)!.textContent || '';
        navigator.clipboard.writeText(text).catch(() => {});
      });
    });
    doConvert();
  }
  mount();
  document.addEventListener('astro:before-swap', () => inputVal.removeEventListener('keydown', handleKeydown));
</script>

<style>
  .field-row { margin-bottom: var(--spacing-md); display: flex; flex-direction: column; gap: var(--spacing-xs); }
  .field-label { font-size: var(--font-size-body-sm); font-weight: 500; color: var(--color-ink); }
  .field-input { padding: 10px 12px; font-size: var(--font-size-body-md); background-color: var(--color-canvas); color: var(--color-ink); border: 1px solid var(--color-hairline); border-radius: var(--border-radius-sm); box-sizing: border-box; width: 100%; }
  .field-input.monospace { font-family: var(--font-geist-mono); }
  .field-input:focus { outline: 2px solid var(--color-ink); outline-offset: 2px; }
  .base-select { padding: 10px 12px; font-size: var(--font-size-body-md); background-color: var(--color-canvas); color: var(--color-ink); border: 1px solid var(--color-hairline); border-radius: var(--border-radius-sm); cursor: pointer; }
  .base-select:focus { outline: 2px solid var(--color-ink); outline-offset: 2px; }
  .button-row { display: flex; gap: var(--spacing-sm); margin: var(--spacing-md) 0; align-items: center; flex-wrap: wrap; }
  .shortcut-hint { font-family: var(--font-geist-mono); font-size: var(--font-size-caption-mono); color: var(--color-mute); }
  @media (min-width: 640px) { .shortcut-hint { margin-left: auto; } }
  .error-msg { font-family: var(--font-geist-mono); font-size: var(--font-size-body-sm); color: var(--color-error); background-color: var(--color-error-soft); padding: var(--spacing-sm) var(--spacing-md); border-radius: var(--border-radius-sm); margin-bottom: var(--spacing-md); }
  .base-results { display: grid; grid-template-columns: 1fr 1fr; gap: var(--spacing-md); }
  @media (max-width: 640px) { .base-results { grid-template-columns: 1fr; } }
  .base-card { background-color: var(--color-canvas-soft-2); border-radius: var(--border-radius-md); border: 1px solid #00000014; padding: var(--spacing-md); display: flex; flex-direction: column; gap: var(--spacing-xs); }
  .base-label { font-family: var(--font-geist-mono); font-size: var(--font-size-caption-mono); color: var(--color-mute); text-transform: uppercase; letter-spacing: 0.05em; }
  .base-value { font-family: var(--font-geist-mono); font-size: var(--font-size-body-md); color: var(--color-ink); word-break: break-all; }
  .base-copy { align-self: flex-start; }
</style>
