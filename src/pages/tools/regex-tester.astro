---
import ToolLayout from '../../layouts/ToolLayout.astro';
---

<ToolLayout
  title="Regex Tester"
  description="Free online regex tester — test regular expressions with live matching. Fast, client-side regex testing tool for developers."
  keywords="regex tester, regular expression tester, regex test online, regex checker, regex validator, online regex tester, free regex tool"
>
  <div class="regex-controls">
    <div class="field-row">
      <label for="pattern" class="field-label">Pattern</label>
      <div class="pattern-wrap">
        <span class="pattern-slash">/</span>
        <input id="pattern" class="pattern-input" placeholder="[a-z]+" value="\w+" />
        <span class="pattern-slash">/</span>
        <input id="flags" class="flags-input" placeholder="gim" value="gm" maxlength="5" title="Regex flags" />
      </div>
    </div>
  </div>

  <div class="field-row">
    <label for="test-input" class="field-label">Test string</label>
    <textarea id="test-input" class="input-area monospace" placeholder="Enter text to test against the regex..." spellcheck="false" autofocus></textarea>
  </div>

  <div class="button-row">
    <button class="btn-primary" id="btn-test">Test</button>
    <button class="btn-secondary" id="btn-clear">Clear</button>
    <button class="btn-secondary-sm" id="btn-sample">Try sample</button>
    <span class="shortcut-hint" aria-live="polite">Ctrl+Enter to test</span>
  </div>

  <div id="error" class="error-msg" role="alert" hidden></div>

  <div id="result-area" class="result-area" hidden>
    <div class="result-stats" id="result-stats"></div>
    <div class="matches-area" id="matches-area"></div>
  </div>
</ToolLayout>

<script>
  const pattern = document.getElementById('pattern') as HTMLInputElement;
  const flags = document.getElementById('flags') as HTMLInputElement;
  const testInput = document.getElementById('test-input') as HTMLTextAreaElement;
  const errorEl = document.getElementById('error') as HTMLDivElement;
  const resultArea = document.getElementById('result-area') as HTMLDivElement;
  const resultStats = document.getElementById('result-stats') as HTMLDivElement;
  const matchesArea = document.getElementById('matches-area') as HTMLDivElement;

  const sampleText = `Hello World
hello@example.com
foo123bar
test_string
HELLO`;

  function testRegex() {
    const pat = pattern.value;
    const flg = flags.value;
    const txt = testInput.value;
    if (!pat) { errorEl.textContent = 'Please enter a regex pattern.'; errorEl.hidden = false; resultArea.hidden = true; return; }
    if (!txt) { errorEl.textContent = 'Please enter a test string.'; errorEl.hidden = false; resultArea.hidden = true; return; }
    errorEl.hidden = true;
    try {
      const regex = new RegExp(pat, flg);
      const matches: string[] = [];
      let match;
      const global = flg.includes('g');
      if (global) {
        while ((match = regex.exec(txt)) !== null) {
          matches.push(match[0]);
        }
      } else {
        match = regex.exec(txt);
        if (match) matches.push(match[0]);
      }
      resultStats.textContent = matches.length + ' match' + (matches.length !== 1 ? 'es' : '') + ' found';
      if (matches.length > 0) {
        let html = '';
        for (const m of matches) {
          html += `<div class="match-item"><code>${m.replace(/</g, '&lt;').replace(/>/g, '&gt;')}</code></div>`;
        }
        matchesArea.innerHTML = html;
      } else {
        matchesArea.innerHTML = '<div class="match-item match-none">No matches</div>';
      }
      resultArea.hidden = false;
    } catch (e) {
      errorEl.textContent = 'Invalid regex: ' + (e as Error).message;
      errorEl.hidden = false;
      resultArea.hidden = true;
    }
  }

  function clearAll() {
    pattern.value = '';
    flags.value = '';
    testInput.value = '';
    errorEl.hidden = true;
    resultArea.hidden = true;
  }

  function loadSample() {
    pattern.value = '\\b\\w+@\\w+\\.\\w+\\b';
    flags.value = 'gm';
    testInput.value = sampleText;
    errorEl.hidden = true;
    resultArea.hidden = true;
  }

  function handleKeydown(e: KeyboardEvent) {
    if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') { e.preventDefault(); testRegex(); }
    if (e.key === 'Escape') { clearAll(); }
  }

  function mount() {
    document.addEventListener('keydown', handleKeydown);
    document.getElementById('btn-test')!.addEventListener('click', testRegex);
    document.getElementById('btn-clear')!.addEventListener('click', clearAll);
    document.getElementById('btn-sample')!.addEventListener('click', loadSample);
  }

  mount();
  document.addEventListener('astro:before-swap', () => document.removeEventListener('keydown', handleKeydown));
</script>

<style>
  .regex-controls { margin-bottom: var(--spacing-md); }
  .field-row { margin-bottom: var(--spacing-md); display: flex; flex-direction: column; gap: var(--spacing-xs); }
  .field-label { font-size: var(--font-size-body-sm); font-weight: 500; color: var(--color-ink); }
  .pattern-wrap { display: flex; align-items: center; gap: 2px; }
  .pattern-slash { font-family: var(--font-geist-mono); font-size: var(--font-size-body-lg); color: var(--color-mute); padding: 0 4px; }
  .pattern-input { flex: 1; padding: 10px 12px; font-family: var(--font-geist-mono); font-size: var(--font-size-body-md); background-color: var(--color-canvas); color: var(--color-ink); border: 1px solid var(--color-hairline); border-radius: 0; box-sizing: border-box; outline: none; }
  .pattern-input:focus { outline: 2px solid var(--color-ink); outline-offset: -2px; z-index: 1; }
  .flags-input { width: 60px; padding: 10px 12px; font-family: var(--font-geist-mono); font-size: var(--font-size-body-md); background-color: var(--color-canvas); color: var(--color-ink); border: 1px solid var(--color-hairline); border-radius: 0; text-align: center; box-sizing: border-box; outline: none; }
  .flags-input:focus { outline: 2px solid var(--color-ink); outline-offset: -2px; }
  .input-area { width: 100%; min-height: 200px; padding: var(--spacing-md); font-size: var(--font-size-code); line-height: 1.5; background-color: var(--color-canvas); color: var(--color-ink); border: 1px solid var(--color-hairline); border-radius: var(--border-radius-sm); resize: vertical; box-sizing: border-box; }
  .input-area.monospace { font-family: var(--font-geist-mono); }
  .input-area:focus { outline: 2px solid var(--color-ink); outline-offset: 2px; }
  .input-area::placeholder { color: var(--color-mute); }
  .button-row { display: flex; gap: var(--spacing-sm); margin: var(--spacing-md) 0; align-items: center; flex-wrap: wrap; }
  .shortcut-hint { font-family: var(--font-geist-mono); font-size: var(--font-size-caption-mono); color: var(--color-mute); }
  @media (min-width: 640px) { .shortcut-hint { margin-left: auto; } }
  .error-msg { font-family: var(--font-geist-mono); font-size: var(--font-size-body-sm); color: var(--color-error); background-color: var(--color-error-soft); padding: var(--spacing-sm) var(--spacing-md); border-radius: var(--border-radius-sm); margin-bottom: var(--spacing-md); }
  .result-area { background-color: var(--color-canvas-soft-2); border-radius: var(--border-radius-md); border: 1px solid #00000014; padding: 1rem; }
  .result-stats { font-family: var(--font-geist-mono); font-size: var(--font-size-caption-mono); color: var(--color-body); margin-bottom: var(--spacing-md); }
  .matches-area { display: flex; flex-direction: column; gap: var(--spacing-xs); }
  .match-item { font-family: var(--font-geist-mono); font-size: var(--font-size-code); color: var(--color-ink); padding: 6px 10px; background-color: var(--color-canvas); border-radius: var(--border-radius-xs); }
  .match-item code { word-break: break-all; }
  .match-none { color: var(--color-mute); }
</style>
