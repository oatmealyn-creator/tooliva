---
import ToolLayout from '../../layouts/ToolLayout.astro';
---

<ToolLayout
  title="SQL Formatter"
  description="Free online SQL formatter — format and beautify SQL queries instantly. Fast, client-side SQL formatting tool for developers."
  keywords="sql formatter, sql beautifier, sql format online, format sql query, sql prettifier, sql formatter tool, free sql formatter, sql query formatter"
>
  <div class="tool-header-row">
    <label for="input" class="sr-only">SQL input</label>
    <textarea id="input" class="input-area monospace" placeholder="Paste your SQL query here..." spellcheck="false" autofocus></textarea>
    <button class="btn-secondary-sm try-sample" id="btn-sample">Try sample</button>
  </div>

  <div class="button-row">
    <button class="btn-primary" id="btn-format">Format</button>
    <button class="btn-secondary" id="btn-minify">Minify</button>
    <button class="btn-secondary" id="btn-copy">Copy</button>
    <button class="btn-secondary" id="btn-clear">Clear</button>
    <span class="shortcut-hint" aria-live="polite">Ctrl+Enter to format</span>
  </div>

  <div id="error" class="error-msg" role="alert" hidden></div>

  <div class="output-area">
    <pre id="output" class="output-content" aria-label="Formatted SQL" data-placeholder="Formatted SQL will appear here..."></pre>
  </div>
</ToolLayout>

<script>
  const input = document.getElementById('input') as HTMLTextAreaElement;
  const output = document.getElementById('output') as HTMLPreElement;
  const errorEl = document.getElementById('error') as HTMLDivElement;
  const copyBtn = document.getElementById('btn-copy') as HTMLButtonElement;

  const sample = `SELECT users.name, COUNT(orders.id) as order_count FROM users LEFT JOIN orders ON users.id = orders.user_id WHERE users.active = 1 AND orders.created_at > '2024-01-01' GROUP BY users.id HAVING order_count > 5 ORDER BY order_count DESC LIMIT 10;`;

  const majorKeywords = ['SELECT', 'FROM', 'WHERE', 'AND', 'OR', 'ORDER BY', 'GROUP BY', 'HAVING', 'LIMIT', 'OFFSET', 'SET', 'VALUES', 'INNER JOIN', 'LEFT JOIN', 'RIGHT JOIN', 'FULL JOIN', 'CROSS JOIN', 'JOIN', 'ON', 'UNION', 'UNION ALL', 'INSERT INTO', 'UPDATE', 'DELETE FROM', 'CREATE TABLE', 'ALTER TABLE', 'DROP TABLE', 'CREATE INDEX', 'DROP INDEX'];
  const subKeywords = ['IN', 'NOT IN', 'LIKE', 'NOT LIKE', 'BETWEEN', 'IS NULL', 'IS NOT NULL', 'AS', 'DISTINCT', 'ALL', 'ANY', 'EXISTS', 'NOT EXISTS', 'CASE', 'WHEN', 'THEN', 'ELSE', 'END', 'ASC', 'DESC'];

  function formatSQL(sql: string): string {
    let s = sql.trim();
    if (!s) return s;

    const allKW = [...majorKeywords, ...subKeywords].sort((a, b) => b.length - a.length);
    const pattern = new RegExp('\\b(' + allKW.map(k => k.replace(/ /g, '\\s+')).join('|') + ')\\b', 'gi');

    s = s.replace(/\s+/g, ' ');
    s = s.replace(pattern, (match) => match.toUpperCase());
    s = s.replace(/\(/g, ' ( ').replace(/\)/g, ' ) ');
    s = s.replace(/,\s*/g, ', ');
    s = s.replace(/\s+/g, ' ');

    const tokens = s.split(' ').filter(t => t.length > 0);
    const lines: string[] = [];
    let indent = 0;

    for (let i = 0; i < tokens.length; i++) {
      const t = tokens[i];
      const upper = t.toUpperCase();
      const combined = (i < tokens.length - 1) ? upper + ' ' + tokens[i + 1].toUpperCase() : '';

      const isMajor = majorKeywords.some(k => {
        const kc = k.replace(/ /g, '\\s+');
        return new RegExp('^' + kc + '$', 'i').test(upper) ||
          (k.includes(' ') && new RegExp('^' + kc.replace(/\\s\\+/, ' ') + '$', 'i').test(combined.trim()));
      });

      const isCloseParen = t === ')';
      if (isCloseParen) indent = Math.max(0, indent - 1);

      if (isMajor && lines.length > 0) {
        lines.push('');
        lines.push(' '.repeat(indent * 2) + t);
      } else if (t === '(') {
        if (!lines.length) lines.push(' '.repeat(indent * 2) + t);
        else lines[lines.length - 1] += ' ' + t;
        indent++;
      } else if (t === ')') {
        lines.push(' '.repeat(indent * 2) + t);
      } else if (t === ',') {
        lines[lines.length - 1] += ',';
      } else {
        if (!lines.length) lines.push(' '.repeat(indent * 2) + t);
        else lines[lines.length - 1] += ' ' + t;
      }
    }

    return lines.join('\n').replace(/\s+\)/g, ')').replace(/\(\s+/g, '(')
      .replace(/\(\s+/g, '(').replace(/\s+\)/g, ')').trim();
  }

  function minifySQL(sql: string): string {
    return sql.trim().replace(/\s+/g, ' ').replace(/\s*\(\s*/g, '(').replace(/\s*\)\s*/g, ')').replace(/\s*,\s*/g, ',').trim();
  }

  function doFormat() {
    const raw = input.value.trim();
    if (!raw) { errorEl.textContent = 'Please enter a SQL query.'; errorEl.hidden = false; output.textContent = ''; return; }
    errorEl.hidden = true;
    try { output.textContent = formatSQL(raw); } catch { output.textContent = raw; }
  }

  function doMinify() {
    const raw = input.value.trim();
    if (!raw) { errorEl.textContent = 'Please enter a SQL query.'; errorEl.hidden = false; output.textContent = ''; return; }
    errorEl.hidden = true;
    output.textContent = minifySQL(raw);
  }

  function copyOutput() {
    const text = output.textContent;
    if (!text) return;
    navigator.clipboard.writeText(text).then(() => {
      const orig = copyBtn.textContent || '';
      copyBtn.textContent = 'Copied \u2713';
      copyBtn.classList.add('btn-copied');
      setTimeout(() => { copyBtn.textContent = orig; copyBtn.classList.remove('btn-copied'); }, 1500);
    }).catch(() => {});
  }

  function clearAll() {
    input.value = '';
    output.textContent = '';
    errorEl.hidden = true;
  }

  function loadSample() { input.value = sample; output.textContent = ''; errorEl.hidden = true; }

  function handleKeydown(e: KeyboardEvent) {
    if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') { e.preventDefault(); doFormat(); }
    if (e.key === 'Escape') { clearAll(); }
  }

  function mount() {
    input.addEventListener('keydown', handleKeydown);
    document.getElementById('btn-format')!.addEventListener('click', doFormat);
    document.getElementById('btn-minify')!.addEventListener('click', doMinify);
    document.getElementById('btn-copy')!.addEventListener('click', copyOutput);
    document.getElementById('btn-clear')!.addEventListener('click', clearAll);
    document.getElementById('btn-sample')!.addEventListener('click', loadSample);
  }
  mount();
  document.addEventListener('astro:before-swap', () => input.removeEventListener('keydown', handleKeydown));
</script>

<style>
  .tool-header-row { position: relative; }
  .try-sample { position: absolute; top: var(--spacing-sm); right: var(--spacing-sm); z-index: 1; }
  .input-area { width: 100%; min-height: 200px; padding: var(--spacing-md); font-size: var(--font-size-code); line-height: 1.5; background-color: var(--color-canvas); color: var(--color-ink); border: 1px solid var(--color-hairline); border-radius: var(--border-radius-sm); resize: vertical; box-sizing: border-box; }
  .input-area.monospace { font-family: var(--font-geist-mono); }
  .input-area:focus { outline: 2px solid var(--color-ink); outline-offset: 2px; }
  .input-area::placeholder { color: var(--color-mute); }
  .button-row { display: flex; gap: var(--spacing-sm); margin: var(--spacing-md) 0; align-items: center; flex-wrap: wrap; }
  .shortcut-hint { font-family: var(--font-geist-mono); font-size: var(--font-size-caption-mono); color: var(--color-mute); }
  @media (min-width: 640px) { .shortcut-hint { margin-left: auto; } }
  .error-msg { font-family: var(--font-geist-mono); font-size: var(--font-size-body-sm); color: var(--color-error); background-color: var(--color-error-soft); padding: var(--spacing-sm) var(--spacing-md); border-radius: var(--border-radius-sm); margin-bottom: var(--spacing-md); }
  .output-area { background-color: var(--color-canvas-soft-2); border-radius: var(--border-radius-md); border: 1px solid #00000014; padding: 1rem; min-height: 200px; max-height: 600px; overflow-y: auto; }
  .output-content { font-family: var(--font-geist-mono); font-size: var(--font-size-code); line-height: 1.5; color: var(--color-ink); margin: 0; white-space: pre-wrap; word-break: break-all; }
</style>
