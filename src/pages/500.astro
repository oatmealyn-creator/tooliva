---
import Layout from '../layouts/MainLayout.astro';
import Footer from '../components/Footer.astro';
---

<Layout pageTitle="Error — Tooliva" pageDescription="Something went wrong.">
  <section class="err-band">
    <div class="err-content">
      <span class="err-logo">Tooliva</span>
      <h1 class="err-code">500.</h1>
      <p class="err-subtitle">Something went wrong. Please try again or go back to the homepage.</p>
      <div class="err-actions">
        <a href="/" class="btn-primary err-cta">Go Home</a>
        <button onclick="location.reload()" class="btn-secondary err-cta">Try Again</button>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  .err-band {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 70vh;
    padding: var(--spacing-4xl) var(--spacing-lg);
    background-color: var(--color-canvas-soft);
  }
  .err-content {
    text-align: center;
    max-width: 480px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-md);
  }
  .err-logo {
    font-size: var(--font-size-body-sm);
    font-weight: 600;
    color: var(--color-mute);
    letter-spacing: 2px;
    text-transform: uppercase;
  }
  .err-code {
    font-size: var(--font-size-display-xl);
    font-weight: var(--font-weight-display-xl);
    letter-spacing: -2.4px;
    line-height: 1;
    color: var(--color-ink);
    margin: 0;
  }
  .err-subtitle {
    font-size: var(--font-size-body-md);
    font-weight: var(--font-weight-body-md);
    color: var(--color-body);
    margin: 0;
    line-height: 1.5;
  }
  .err-actions {
    display: flex;
    gap: var(--spacing-md);
    margin-top: var(--spacing-sm);
  }
  .err-cta {
    display: inline-block;
    text-decoration: none;
    cursor: pointer;
  }
</style>
