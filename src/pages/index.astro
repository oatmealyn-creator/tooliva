---
import Nav from '../components/Nav.astro';
import ToolCard from '../components/ToolCard.astro';
import Layout from '../layouts/MainLayout.astro';
import { tools } from '../data/tools';
---

<Layout>
  <Nav />

  <section class="hero-band">
    <div class="mesh-gradient" aria-hidden="true" />
    <div class="hero-content">
      <span class="badge-secondary">Tools &middot; Utility &middot; Speed</span>
      <h1 class="hero-title">Developer tools, done right.</h1>
      <p class="hero-subtitle">
        The tools you Google &mdash; but fast, clean, and ad-free.
      </p>
      <div class="hero-cta">
        <button class="btn-primary">Get Started</button>
        <button class="btn-secondary">Learn More</button>
      </div>
    </div>
  </section>

  <section class="tools-band">
    <div class="tools-container">
      <h2 class="section-title">Every tool you need.</h2>
      <p class="section-subtitle">Quick, reliable utilities for developers &mdash; no ads, no fuss.</p>
      <div class="tools-grid">
        {tools.map((tool) => (
          <ToolCard name={tool.name} slug={tool.slug} description={tool.description} category={tool.category} />
        ))}
      </div>
    </div>
  </section>
</Layout>