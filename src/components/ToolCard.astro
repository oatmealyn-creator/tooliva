---
export interface Props {
  name: string;
  slug: string;
  description: string;
  category: string;
}

const { name, slug, description, category } = Astro.props;
---

<a href={`/tools/${slug}`} class="tool-card">
  <span class="category">&lt;{category} /&gt;</span>
  <h3 class="name">{name}</h3>
  <p class="description">{description}</p>
</a>

<style>
  .tool-card {
    display: block;
    background-color: var(--color-canvas);
    border-radius: var(--border-radius-md);
    padding: var(--spacing-lg);
    box-shadow: var(--box-shadow-level-3);
    border: 1px solid #00000014;
    text-decoration: none;
    transition:
      box-shadow 0.2s ease,
      transform 0.2s ease;
  }
  .tool-card:hover {
    box-shadow:
      var(--box-shadow-level-4),
      0 4px 12px rgba(0, 0, 0, 0.08);
    transform: translateY(-4px);
  }
  .category {
    font-family: var(--font-geist-mono);
    font-size: var(--font-size-caption-mono);
    line-height: 1;
    color: var(--color-mute);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .name {
    font-family: var(--font-geist);
    font-size: var(--font-size-display-sm);
    font-weight: var(--font-weight-display-sm);
    letter-spacing: -0.6px;
    color: var(--color-ink);
    margin: var(--spacing-sm) 0 var(--spacing-xs);
    line-height: 1.4;
  }
  .description {
    font-family: var(--font-geist);
    font-size: var(--font-size-body-sm);
    font-weight: var(--font-weight-body-sm);
    letter-spacing: -0.28px;
    color: var(--color-mute);
    margin: 0;
    line-height: 1.4;
  }
</style>
