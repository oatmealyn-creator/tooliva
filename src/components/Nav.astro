---
const pathname = Astro.url.pathname;

function isActive(href: string): boolean {
  if (href === '/') return pathname === '/';
  return pathname.startsWith(href);
}
---

<nav class="nav-bar" aria-label="Main navigation">
  <div class="flex items-center">
    <a href="/" class="logo">Tooliva</a>
  </div>

  <input type="checkbox" id="menu-toggle" class="menu-toggle" />
  <label for="menu-toggle" class="menu-icon" aria-label="Toggle navigation menu" role="button" tabindex="0">☰</label>

  <div class="nav-links">
    <a href="/about" class:list={['nav-link', { active: isActive('/about') }]}>About</a>
    <a href="/contact" class:list={['nav-link', { active: isActive('/contact') }]}>Contact</a>
  </div>
</nav>
