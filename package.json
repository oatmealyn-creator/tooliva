{
  "name": "tooliva",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint \"**/*.{ts,js,astro}\" --max-warnings=0",
    "format": "prettier --write .",
    "deploy:cf": "astro build && wrangler pages deploy dist/ --project-name tooliva",
    "deploy:vercel": "astro build && vercel --prod --yes"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource/geist-mono": "^5.2.8",
    "astro": "^6.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@tailwindcss/postcss": "^4.3.0",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "astro-eslint-parser": "^1.4.0",
    "eslint": "^8.57.1",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "wrangler": "^4.97.0"
  },
  "description": "A collection of fast, clean developer utilities — JSON formatter, JWT decoder, Base64 encoder, and more.",
  "main": "index.js",
  "repository": {
